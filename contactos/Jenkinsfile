
pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    stages {
        stage('Compilar') {
            steps {
                dir('contactos') {
                    bat 'mvn -B clean compile'
                }
            }
        }

        stage('Probar') {
            steps {
                dir('contactos') {
                    bat 'mvn -B test'
                }
            }
            post {
                always {
                    junit testResults: 'contactos/target/surefire-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Empaquetar') {
            steps {
                dir('contactos') {
                    bat 'mvn -B package -DskipTests'
                }
                archiveArtifacts artifacts: 'contactos/target/*.jar'
            }
        }
    }
}