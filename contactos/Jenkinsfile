
pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    stages {
        stage('Compilar') {
            steps {
                dir('contactos') {
                    bat 'mvn -B clean compile'
                }
            }
        }

        stage('Probar') {
            steps {
                dir('contactos') {
                    bat 'mvn -B test'
                }
            }
            post {
                always {
                    junit testResults: 'contactos/target/surefire-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Empaquetar') {
            steps {
                dir('contactos') {
                    bat 'mvn -B package -DskipTests'
                }
                archiveArtifacts artifacts: 'contactos/target/*.jar'
            }
        }
    }
    // Avisos al finalizar la construccion
    post {
        failure {
            echo "FALLO: la construccion ${env.BUILD_NUMBER} de ${env.JOB_NAME} ha fallado. Revisar la etapa en rojo."
        }

        success {
            echo "OK: la construccion ${env.BUILD_NUMBER} de ${env.JOB_NAME} ha terminado bien."
        }

        fixed {
            echo "RECUPERADA: ${env.JOB_NAME} vuelve a funcionar desde la construccion ${env.BUILD_NUMBER}."
        }
    }

}